.git
.gitignore
.gitattributes

# Documentation
*.md
!README.md
IMPROVEMENT_SUGGESTIONS.md

# Logs
logs
*.log

# OS
.DS_Store
Thumbs.db

# OpenAPI
swagger.json
src/api-service/generated/

# Misc
.editorconfig
.prettierrc
